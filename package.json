{
  "name": "emma-node",
  "version": "1.0.0",
  "description": "Node.js and React port of Hybrid Emma",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "dev:client": "vite --configLoader runner",
    "build": "vite build --configLoader runner",
    "preview": "vite preview --configLoader runner",
    "check": "tsc --noEmit",
    "test": "vitest run --configLoader runner"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^10.1.0",
    "@fastify/static": "^10.1.2",
    "@langchain/anthropic": "^1.5.2",
    "@langchain/core": "^1.2.4",
    "@langchain/google-genai": "^2.2.0",
    "@langchain/ollama": "^1.3.0",
    "@langchain/openai": "^1.5.5",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "fastify": "^5.11.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.1.4",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
